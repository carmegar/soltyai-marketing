# Copiar a .env y llenar. NUNCA commitear .env (secretos → Vaultwarden).

# Anthropic — motor de contenido y enriquecimiento (src/contenido, pendiente)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Bot de Telegram al que apuntan los deep-links generados por src/links
# (sin @; el mismo del vertical que se esté promocionando)
TELEGRAM_BOT_USERNAME=inmobiliaria_solty_bot

# Dominio de la landing puente /ir (08-TRACKING-SETUP §3)
LANDING_BASE_URL=https://soltyai.com

# WhatsApp de contacto humano para la 3ª CTA (formato internacional sin +)
WHATSAPP_NUMERO=57XXXXXXXXXX

# Calendly de la demo (13-PLAN-12-CLIENTES §6)
CALENDLY_URL=https://calendly.com/xxxx/demo

# Suite (back-office) — para src/cotizar, pendiente. Token con scope de escritura.
SUITE_BASE_URL=https://suite.soltyai.com
SUITE_MCP_TOKEN=
